{
  "name": "ordo",
  "version": "0.1.0",
  "private": true,
  "description": "Ordo — a time-first group coordination app.",
  "scripts": {
    "dev:api": "pnpm --filter @ordo/api dev",
    "build:api": "pnpm --filter @ordo/api build",
    "db:migrate": "pnpm --filter @ordo/api prisma:migrate",
    "db:reset": "pnpm --filter @ordo/api prisma:reset",
    "db:seed": "pnpm --filter @ordo/api seed",
    "db:studio": "pnpm --filter @ordo/api prisma:studio",
    "mobile:get": "cd apps/mobile && flutter pub get",
    "mobile:run": "cd apps/mobile && flutter run",
    "mobile:buildweb": "cd apps/mobile && flutter build web",
    "mobile:analyze": "cd apps/mobile && flutter analyze"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core"
    ]
  }
}
