# Ordo API environment
# Copy this file to .env and fill in real values:
#   cp apps/api/.env.example apps/api/.env

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# PostgreSQL — replace <your-password> with your local postgres user password
DATABASE_URL="postgresql://postgres:<your-password>@localhost:5432/ordo?schema=public"

# Auth — these are placeholders. Generate strong random secrets for any
# non-local deployment, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_strong_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# Client app
CLIENT_ORIGIN=http://localhost:3000
